# Public devnet endpoints (these are the defaults; no secrets are needed or used).
NEXT_PUBLIC_VAULT_REST=https://vaultl1-devnet.fly.dev
NEXT_PUBLIC_VAULT_PROVIDER=https://vaultl1-provider.fly.dev

# "proxy" (default): the browser calls this site's /api/provider route, which forwards to the provider.
# "direct": the browser calls the provider itself (needs the provider's ALLOW_ORIGIN to include this site's origin).
NEXT_PUBLIC_VAULT_PROVIDER_MODE=proxy

# Optional, server side only: where the proxy forwards to (defaults to NEXT_PUBLIC_VAULT_PROVIDER).
# VAULT_PROVIDER_URL=https://vaultl1-provider.fly.dev
